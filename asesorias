import tkinter as tk
from tkinter import ttk, messagebox

class ModuloAsesorias:
    def _init_(self, root):
        self.root = root
        self.root.title("Software FJ - Módulo de Asesorías")
        self.root.geometry("950x620")
        self.root.configure(bg="#f4f7f6")

        # Diccionario de temas y sus tarifas por hora
        self.tarifas_temas = {
            "Consultoría Financiera": 30000,
            "Asesoría Legal": 45000,
            "Estrategia Digital": 25000,
            "Desarrollo de Software": 60000
        }

        # Variables de control para los cálculos
        self.subtotal_actual = 0.0
        self.descuento_actual = 0.0
        self.iva_actual = 0.0
        self.total_actual = 0.0

        self.crear_interfaz()

    def crear_interfaz(self):
        # Título
        titulo = tk.Label(
            self.root, text="Software FJ - Gestión de Asesorías",
            font=("Segoe UI", 16, "bold"), bg="#f4f7f6", fg="#2c3e50"
        )
        titulo.pack(pady=10)

        # Marco del Formulario
        frame_form = tk.LabelFrame(
            self.root, text="Datos de la Asesoría",
            font=("Segoe UI", 10, "bold"), bg="#ffffff", padx=15, pady=15
        )
        frame_form.pack(fill="x", padx=20, pady=5)

        # Fila 0: Documento y Nombre del Cliente
        tk.Label(frame_form, text="Documento del Cliente:", bg="#ffffff").grid(row=0, column=0, sticky="w", pady=5)
        self.entry_documento = tk.Entry(frame_form, width=30)
        self.entry_documento.grid(row=0, column=1, padx=10, pady=5)

        tk.Label(frame_form, text="Nombre del Cliente:", bg="#ffffff").grid(row=0, column=2, sticky="w", pady=5)
        self.entry_cliente = tk.Entry(frame_form, width=35)
        self.entry_cliente.grid(row=0, column=3, padx=10, pady=5)

        # Fila 1: Especialista y Tema (Lista desplegable)
        tk.Label(frame_form, text="Especialista:", bg="#ffffff").grid(row=1, column=0, sticky="w", pady=5)
        self.entry_especialista = tk.Entry(frame_form, width=30)
        self.entry_especialista.grid(row=1, column=1, padx=10, pady=5)

        tk.Label(frame_form, text="Tema de Asesoría:", bg="#ffffff").grid(row=1, column=2, sticky="w", pady=5)
        self.combo_tema = ttk.Combobox(
            frame_form, values=list(self.tarifas_temas.keys()),
            state="readonly", width=32
        )
        self.combo_tema.grid(row=1, column=3, padx=10, pady=5)
        self.combo_tema.bind("<<ComboboxSelected>>", self.asignar_tarifa)

        # Fila 2: Cantidad de Horas y Tarifa Automática
        tk.Label(frame_form, text="Cantidad de Horas:", bg="#ffffff").grid(row=2, column=0, sticky="w", pady=5)
        self.entry_horas = tk.Entry(frame_form, width=30)
        self.entry_horas.grid(row=2, column=1, padx=10, pady=5)

        tk.Label(frame_form, text="Tarifa por Hora ($):", bg="#ffffff").grid(row=2, column=2, sticky="w", pady=5)
        self.entry_tarifa = tk.Entry(frame_form, width=35, state="readonly")
        self.entry_tarifa.grid(row=2, column=3, padx=10, pady=5)

        # Panel de Resumen Financiero
        frame_resumen = tk.Frame(self.root, bg="#e9ecef", bd=1, relief="solid", padx=15, pady=10)
        frame_resumen.pack(fill="x", padx=20, pady=10)

        self.lbl_subtotal = tk.Label(frame_resumen, text="Subtotal: $0", font=("Segoe UI", 10, "bold"), bg="#e9ecef")
        self.lbl_subtotal.pack(side="left", expand=True)

        self.lbl_descuento = tk.Label(frame_resumen, text="Descuento (10%): $0", font=("Segoe UI", 10, "bold"), bg="#e9ecef", fg="#d35400")
        self.lbl_descuento.pack(side="left", expand=True)

        self.lbl_iva = tk.Label(frame_resumen, text="IVA (19%): $0", font=("Segoe UI", 10, "bold"), bg="#e9ecef")
        self.lbl_iva.pack(side="left", expand=True)

        self.lbl_total = tk.Label(frame_resumen, text="Total a Pagar: $0", font=("Segoe UI", 12, "bold"), bg="#e9ecef", fg="#27ae60")
        self.lbl_total.pack(side="left", expand=True)

        # Botones de Acción
        frame_botones = tk.Frame(self.root, bg="#f4f7f6")
        frame_botones.pack(pady=10)

        btn_calcular = tk.Button(
            frame_botones, text="Calcular Costo", command=self.calcular_costo,
            bg="#3498db", fg="white", font=("Segoe UI", 10, "bold"), width=18, pady=5
        )
        btn_calcular.grid(row=0, column=0, padx=10)

        btn_registrar = tk.Button(
            frame_botones, text="Registrar Asesoría", command=self.registrar_asesoria,
            bg="#2ecc71", fg="white", font=("Segoe UI", 10, "bold"), width=18, pady=5
        )
        btn_registrar.grid(row=0, column=1, padx=10)

        btn_limpiar = tk.Button(
            frame_botones, text="Limpiar Campos", command=self.limpiar_campos,
            bg="#e74c3c", fg="white", font=("Segoe UI", 10, "bold"), width=18, pady=5
        )
        btn_limpiar.grid(row=0, column=2, padx=10)

        # Tabla de Registros (Treeview)
        frame_tabla = tk.Frame(self.root)
        frame_tabla.pack(fill="both", expand=True, padx=20, pady=10)

        columnas = ("documento", "cliente", "especialista", "tema", "horas", "subtotal", "descuento", "iva", "total")
        self.tabla = ttk.Treeview(frame_tabla, columns=columnas, show="headings", height=10)

        encabezados = {
            "documento": "Documento", "cliente": "Cliente", "especialista": "Especialista",
            "tema": "Tema", "horas": "Horas", "subtotal": "Subtotal",
            "descuento": "Descuento", "iva": "IVA (19%)", "total": "Total Pagado"
        }

        for col, texto in encabezados.items():
            self.tabla.heading(col, text=texto)
            ancho = 130 if col in ("cliente", "especialista", "tema") else 85
            self.tabla.column(col, width=ancho, anchor="center")

        self.tabla.pack(side="left", fill="both", expand=True)

        scrollbar = ttk.Scrollbar(frame_tabla, orient="vertical", command=self.tabla.yview)
        self.tabla.configure(yscroll=scrollbar.set)
        scrollbar.pack(side="right", fill="y")

    def asignar_tarifa(self, event=None):
        tema_seleccionado = self.combo_tema.get()
        tarifa = self.tarifas_temas.get(tema_seleccionado, 0)

        self.entry_tarifa.config(state="normal")
        self.entry_tarifa.delete(0, tk.END)
        self.entry_tarifa.insert(0, str(tarifa))
        self.entry_tarifa.config(state="readonly")

    def calcular_costo(self):
        tema = self.combo_tema.get()
        horas_texto = self.entry_horas.get().strip()

        if not tema:
            messagebox.showwarning("Atención", "Por favor seleccione un tema de asesoría.")
            return False

        if not horas_texto.isdigit() or int(horas_texto) <= 0:
            messagebox.showwarning("Atención", "Ingrese una cantidad de horas válida (número entero mayor a 0).")
            return False

        horas = int(horas_texto)
        tarifa = self.tarifas_temas[tema]

        self.subtotal_actual = tarifa * horas

        # Descuento del 10% si supera los $50,000
        if self.subtotal_actual > 50000:
            self.descuento_actual = self.subtotal_actual * 0.10
        else:
            self.descuento_actual = 0.0

        base_imponible = self.subtotal_actual - self.descuento_actual
        self.iva_actual = base_imponible * 0.19
        self.total_actual = base_imponible + self.iva_actual

        # Actualizar etiquetas visuales
        self.lbl_subtotal.config(text=f"Subtotal: ${self.subtotal_actual:,.0f}")
        self.lbl_descuento.config(text=f"Descuento (10%): ${self.descuento_actual:,.0f}")
        self.lbl_iva.config(text=f"IVA (19%): ${self.iva_actual:,.0f}")
        self.lbl_total.config(text=f"Total a Pagar: ${self.total_actual:,.0f}")

        return True

    def registrar_asesoria(self):
        documento = self.entry_documento.get().strip()
        cliente = self.entry_cliente.get().strip()
        especialista = self.entry_especialista.get().strip()
        tema = self.combo_tema.get()
        horas = self.entry_horas.get().strip()

        if not documento or not cliente or not especialista or not tema:
            messagebox.showerror("Error", "Todos los campos son obligatorios para registrar.")
            return

        # Recalcular antes de guardar para asegurar datos exactos
        if not self.calcular_costo():
            return

        # Insertar en la tabla inferior
        self.tabla.insert("", tk.END, values=(
            documento,
            cliente,
            especialista,
            tema,
            horas,
            f"${self.subtotal_actual:,.0f}",
            f"${self.descuento_actual:,.0f}",
            f"${self.iva_actual:,.0f}",
            f"${self.total_actual:,.0f}"
        ))

        messagebox.showinfo("Éxito", "Asesoría registrada correctamente en Software FJ.")
        self.limpiar_campos()

    def limpiar_campos(self):
        self.entry_documento.delete(0, tk.END)
        self.entry_cliente.delete(0, tk.END)
        self.entry_especialista.delete(0, tk.END)
        self.combo_tema.set("")
        self.entry_horas.delete(0, tk.END)

        self.entry_tarifa.config(state="normal")
        self.entry_tarifa.delete(0, tk.END)
        self.entry_tarifa.config(state="readonly")

        self.subtotal_actual = 0.0
        self.descuento_actual = 0.0
        self.iva_actual = 0.0
        self.total_actual = 0.0

        self.lbl_subtotal.config(text="Subtotal: $0")
        self.lbl_descuento.config(text="Descuento (10%): $0")
        self.lbl_iva.config(text="IVA (19%): $0")
        self.lbl_total.config(text="Total a Pagar: $0")

if _name_ == "_main_":
    ventana = tk.Tk()
    app = ModuloAsesorias(ventana)
    ventana.mainloop()
